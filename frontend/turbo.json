{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"]
    }
  }
}
